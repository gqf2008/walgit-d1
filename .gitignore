target/
*.orig

# Windows installer build output (deploy/windows/installer.iss via ISCC)
deploy/windows/Output/

# macOS tray build output (deploy/tray/macos/build-dmg.sh)
deploy/tray/macos/dist/

# local secrets / environment — never in the repo
.env
.env.*
*.senv
.senv
.dev/
.pi/

# local review dumps (findings, smoketests, notes — not for the repo)
.review/

# built web assets (embedded into the binary at build time; `just web-build`)
web/dist/
web/node_modules/
node_modules/

# nix build outputs
result
result-*

# macOS/ExFAT AppleDouble junk (see LESSON_ExFAT卷同步文件生成点下划线AppleDouble需gitignore排除)
._*

# CI step artefact: the zero-test assertion tees the integration run here
# (ci.yml "Fast tier", "CLI integration suites" and windows "Server integration").
# Locally reproducible.
server-integration.log
cli-integration.log

# agent worktrees live inside the checkout (.worktrees/<unit>) — never in the repo
.worktrees/

# Python bytecode caches (agent scripts/tests)
__pycache__/
*.pyc
