#!/usr/bin/env bash
# walgit-ensure — 兼容壳。服务生命周期已经由 **walgit 二进制**负责
# (`walgit service start|stop|status`),这个脚本不再自己判断存活、不再起
# screen、不再截断日志;它只把旧名字转发过去,给旧版托盘/安装器/文档一个入口。
set -euo pipefail
BASE="${WALGIT_DEPLOY_DIR:-$HOME/.walgit}"
CONFIG="${WALGIT_CONFIG:-$BASE/walgit.toml}"
case "${1:-start}" in
  ensure|start|"") verb=start ;;
  stop|status|restart) verb="$1" ;;
  *)
    echo "用法: walgit-ensure [start|stop|status|restart]（= walgit service …）" >&2
    exit 2
    ;;
esac
exec "$BASE/walgit" service "$verb" --config "$CONFIG"
